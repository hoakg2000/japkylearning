     {
      "surface": "七時",
      "reading": "しちじ"
     },
     {
      "surface": "です。"
     }
    ],
    "romaji": "ima gozen shichiji desu.",
    "translation": {
     "vi": "Bây giờ là bảy giờ sáng.",
     "en": "It is 7 a.m. now."
    },
    "source": "japky"
   },
   {
    "ja": "九時半です。",
    "segments": [
     {
      "surface": "九時",
      "reading": "くじ"
     },
     {
      "surface": "半",
      "reading": "はん"
     },
     {
      "surface": "です。"
     }
    ],
    "romaji": "kuji han desu.",
    "translation": {
     "vi": "Chín giờ rưỡi.",
     "en": "It is half past nine."
    },
    "source": "japky"
   }
  ],
  "cloze": [
   {
