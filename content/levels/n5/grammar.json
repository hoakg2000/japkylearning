     "en": "I am a student."
    }
   },
   {
    "ja": "田中さんは先生です。",
    "blank": "です",
    "translation": {
     "vi": "Anh Tanaka là giáo viên.",
     "en": "Mr Tanaka is a teacher."
    }
   }
  ],
  "jlpt": "n5"
 },
