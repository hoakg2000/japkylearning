    "translation": {
     "vi": "Đây là đồng hồ.",
     "en": "This is a watch."
    },
    "source": "japky"
   },
   {
    "ja": "あの人は先生です。",
    "segments": [
     {
      "surface": "あの"
     },
     {
      "surface": "人",
      "reading": "ひと"
     },
     {
      "surface": "は"
     },
     {
      "surface": "先生",
      "reading": "せんせい"
     },
     {
      "surface": "です。"
     }
    ],
    "romaji": "ano hito wa sensei desu.",
    "translation": {
     "vi": "Người kia là giáo viên.",
     "en": "That person is a teacher."
