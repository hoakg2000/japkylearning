[
 {
  "id": "n5-wa-desu",
  "pattern": "N1 は N2 です",
  "meaning": {
   "vi": "N1 là N2",
   "en": "N1 is N2"
  },
  "explanation": {
   "vi": "は (đọc là \"wa\") đánh dấu chủ đề của câu. です đặt cuối câu, làm câu lịch sự. Cấu trúc dùng để nói ai/cái gì là gì.",
   "en": "は (read \"wa\") marks the topic. です ends the sentence politely. Use it to say what someone or something is."
  },
  "examples": [
   {
    "ja": "私はミンです。",
    "segments": [
     {
      "surface": "私",
      "reading": "わたし"
     },
     {
      "surface": "はミンです。"
     }
    ],
    "romaji": "watashi wa min desu.",
    "translation": {
     "vi": "Tôi là Minh.",
     "en": "I am Minh."
    },
    "source": "japky"
   },
   {
    "ja": "ランさんは会社員です。",
    "segments": [
     {
      "surface": "ランさんは"
     },
     {
      "surface": "会社員",
      "reading": "かいしゃいん"
     },
     {
      "surface": "です。"
     }
    ],
    "romaji": "ran san wa kaishain desu.",
    "translation": {
     "vi": "Chị Lan là nhân viên công ty.",
     "en": "Lan is a company employee."
    },
    "source": "japky"
   }
  ],
  "cloze": [
   {
