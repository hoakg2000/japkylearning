 {
  "id": "n5-masu",
  "pattern": "V-ます / V-ません",
  "meaning": {
   "vi": "làm / không làm (lịch sự, hiện tại – tương lai)",
   "en": "do / do not (polite, present–future)"
  },
  "explanation": {
   "vi": "Thể ます là cách nói lịch sự của động từ, dùng cho thói quen và việc sẽ làm. Phủ định: đổi ます thành ません. Ví dụ: 食べる → 食べます → 食べません.",
   "en": "The ます form is the polite verb form for habits and future actions. Negative: change ます to ません. 食べる → 食べます → 食べません."
  },
  "examples": [
   {
    "ja": "毎日日本語を勉強します。",
    "segments": [
     {
      "surface": "毎日",
      "reading": "まいにち"
     },
     {
      "surface": "日本語",
      "reading": "にほんご"
     },
     {
      "surface": "を"
     },
     {
      "surface": "勉強",
      "reading": "べんきょう"
     },
     {
      "surface": "します。"
     }
    ],
    "romaji": "mainichi nihongo o benkyou shimasu.",
    "translation": {
     "vi": "Hằng ngày tôi học tiếng Nhật.",
     "en": "I study Japanese every day."
    },
    "source": "japky"
   },
   {
    "ja": "私は朝ご飯を食べません。",
    "segments": [
     {
      "surface": "私",
      "reading": "わたし"
     },
     {
      "surface": "は"
     },
     {
      "surface": "朝",
      "reading": "あさ"
     },
     {
      "surface": "ご"
     },
     {
      "surface": "飯",
      "reading": "はん"
     },
     {
      "surface": "を"
     },
     {
      "surface": "食",
      "reading": "た"
     },
     {
      "surface": "べません。"
     }
    ],
    "romaji": "watashi wa asagohan o tabemasen.",
    "translation": {
     "vi": "Tôi không ăn sáng.",
     "en": "I do not eat breakfast."
    },
    "source": "japky"
   }
  ],
  "cloze": [
   {
    "ja": "水を飲みます。",
